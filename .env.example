# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# --- Frontend (Vite, read via import.meta.env) ---
# Base URL the React API layer (src/api) sends requests to. Defaults to
# '/api' (same-origin) if unset — see src/api/client.ts.
VITE_API_BASE_URL=/api

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=niazabbasi_cms
DB_USER=niazabbasi_cms_user
DB_PASS=change-me
DB_CHARSET=utf8mb4

# --- Application ---
APP_ENV=development
# IANA timezone the backend uses for every date computation (blog publish
# scheduling, created_at/updated_at, session timestamps) and for the MySQL
# session's own time_zone, so both stay consistent. Defaults to Asia/Karachi
# (this site's production timezone) if unset — see
# docs/BLOG-DATE-AND-PUBLISHING-RULES.md.
APP_TIMEZONE=Asia/Karachi
# Absolute or relative (to backend/) path where uploaded files are stored on disk.
UPLOADS_PATH=../uploads

# --- First admin user (used only by install.php, one-time bootstrap) ---
INSTALL_ADMIN_NAME="Site Admin"
# Optional — defaults to the local part of INSTALL_ADMIN_EMAIL if unset.
INSTALL_ADMIN_USERNAME=admin
INSTALL_ADMIN_EMAIL=admin@example.com
INSTALL_ADMIN_PASSWORD=change-me-now

# --- Installer web access (only needed if install.php is run over HTTP
# instead of the CLI, e.g. on hosting without shell access). Required to
# match ?token=... or install.php refuses to run. Leave blank to force
# CLI-only installation. Remove/rotate after installing. ---
INSTALL_TOKEN=
