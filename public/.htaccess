# SPA fallback for client-side routing (React Router) on Hostinger's Apache
# hosting. See docs/03-DEPLOYMENT.md for the full explanation.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Anything that maps to a real file or directory is served as-is:
  # /assets/*.js, /favicon.png, /robots.txt, /sitemap.xml, etc. are all
  # untouched by the rule below.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Social/search link-preview crawlers don't execute JavaScript, so the
  # client-only Open Graph tags src/utils/useSEO.js injects after hydration
  # are invisible to them — they'd see index.html's generic placeholder tags
  # instead of the real post's title/description/image (this is the root
  # cause of "Facebook share shows nothing"). For a /blog/{slug} request
  # from one of these known crawler user agents, serve backend/blog-meta.php
  # instead (deployed at /blog-meta.php — see backend/README's "backend/'s
  # contents live alongside dist/'s output" layout): it reads the real post
  # from the database and injects the correct Open Graph/Twitter meta tags
  # into the same HTML shell. Real visitors and in-app navigation are
  # untouched by this rule.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|Googlebot|bingbot|Applebot|Pinterest|redditbot|SkypeUriPreview|vkShare|W3C_Validator) [NC]
  RewriteRule ^blog/([^/]+)/?$ /blog-meta.php?slug=$1 [L,QSA]

  # Everything else that looks like an app route (no file extension in the
  # last path segment) falls back to index.html so React Router can render
  # it client-side — this is what makes direct loads/refreshes of routes
  # like /blog and /blog/example-slug work.
  #
  # A request that *does* have an extension (e.g. a mistyped or missing
  # /assets/foo.js) is deliberately left alone here, so it 404s normally
  # instead of silently serving the SPA shell.
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,8}$
  RewriteRule ^ index.html [L]
</IfModule>
